// =============================================================================
// Name:       Password spray detection
// Domain:     Threat hunting
// Tables:     SigninLogs
// Severity:   critical
// Safety:     READ-ONLY.
// Purpose:    One source IP, a few password guesses each against many different accounts -
//             low and slow enough to stay under per-account lockout. Detected by pivoting on
//             the source IP rather than the account, which is what makes spray visible at all.
// Tuning:     minTargetedUsers - how many distinct accounts one IP must fail against inside a
//             bucket. 5 is sensitive; raise to 10-20 in a noisy tenant. bucket - the time
//             window; widen to 24h to catch genuinely slow sprays that dodge an hourly window.
// Reading it: Severity CRITICAL means the same IP that sprayed also had at least one SUCCESS -
//             treat CompromisedUsers as confirmed until you prove otherwise. Check UserAgents:
//             a single scripted agent across dozens of accounts is conclusive.
// Next step:  Pivot each CompromisedUser into Threat-MfaMethodAfterRiskySignIn.kql - the
//             attacker's next move after a successful spray is usually to register their own
//             MFA method.
// =============================================================================
let lookback = 7d;
let bucket = 1h;
let minTargetedUsers = 5;
let sprayCodes = dynamic(["50126", "50053", "50055", "50034", "50056", "51004"]);
SigninLogs
| where TimeGenerated > ago(lookback)
| where ResultType in (sprayCodes) or ResultType == "0"
| extend Country = tostring(LocationDetails.countryOrRegion),
         ASN     = tostring(AutonomousSystemNumber)
| summarize FailedUsers      = dcountif(UserPrincipalName, ResultType != "0"),
            Failures         = countif(ResultType != "0"),
            Successes        = countif(ResultType == "0"),
            CompromisedUsers = make_set_if(UserPrincipalName, ResultType == "0", 20),
            TargetedUsers    = make_set_if(UserPrincipalName, ResultType != "0", 25),
            ErrorCodes       = make_set_if(ResultType, ResultType != "0", 6),
            UserAgents       = make_set(UserAgent, 5),
            ClientApps       = make_set(ClientAppUsed, 5),
            Apps             = make_set(AppDisplayName, 5),
            Countries        = make_set(Country, 5),
            ASNs             = make_set(ASN, 5)
        by IPAddress, Window = bin(TimeGenerated, bucket)
| where FailedUsers >= minTargetedUsers
| extend Severity = case(Successes > 0,      "CRITICAL - spray with at least one success",
                         FailedUsers >= 25,  "High",
                         FailedUsers >= 10,  "Medium",
                                             "Low"),
         SeverityRank = case(Successes > 0, 0, FailedUsers >= 25, 1, FailedUsers >= 10, 2, 3)
| project Window, IPAddress, Severity, SeverityRank, FailedUsers, Failures, Successes,
          CompromisedUsers, TargetedUsers, ErrorCodes, Countries, ASNs, UserAgents, ClientApps, Apps
| order by SeverityRank asc, Window desc, FailedUsers desc

// =============================================================================
// Name:       Credentials added to existing applications (persistence)
// Domain:     Threat hunting
// Tables:     AuditLogs
// Severity:   critical
// Safety:     READ-ONLY.
// Purpose:    Adding a new client secret, certificate or federated identity credential to an
//             application that already holds privileged permissions is a quiet, durable
//             backdoor - it survives password resets, MFA changes and session revocation.
//             Every credential addition in the tenant appears here.
// Tuning:     lookback - window. Operation names for secret management have varied over time
//             (and use an en dash in the portal), so this matches on substrings rather than
//             exact names. Verify coverage against your own tenant's audit log once.
// Reading it: Ask three questions of every row. Was this a planned rotation? Does the actor
//             normally manage this app? Was it done outside change hours (see
//             Admin-AfterHoursPrivilegedActivity.kql)? A federated identity credential added to
//             a high-privilege app is especially notable - it lets an external workload
//             authenticate with no secret at all.
// Next step:  IAM/Get-AppCredentialExpiryReport.ps1 lists every credential currently on every
//             app, so you can confirm whether what was added here still exists.
// =============================================================================
let lookback = 30d;
AuditLogs
| where TimeGenerated > ago(lookback)
| where OperationName has_any ("service principal credentials", "Certificates and secrets",
        "application certificate", "federated identity credential", "Add application password",
        "Update application", "Add owner to application", "Add owner to service principal")
| where ResultType =~ "success"
| extend Actor     = coalesce(tostring(InitiatedBy.user.userPrincipalName), tostring(InitiatedBy.app.displayName)),
         ActorType = iff(isnotempty(tostring(InitiatedBy.app.displayName)), "Application", "User"),
         ActorIp   = tostring(InitiatedBy.user.ipAddress)
| mv-expand Target = TargetResources
| extend TargetName = tostring(Target.displayName),
         TargetType = tostring(Target.type),
         TargetId   = tostring(Target.id)
| mv-expand Prop = Target.modifiedProperties
| extend PropName = tostring(Prop.displayName),
         NewValue = substring(tostring(Prop.newValue), 0, 500),
         OldValue = substring(tostring(Prop.oldValue), 0, 500)
| where PropName has_any ("KeyDescription", "KeyCredentials", "PasswordCredentials",
                          "FederatedIdentityCredentials", "Included Updated Properties", "Owner")
| extend CredentialKind = case(PropName has "Federated",      "Federated identity credential",
                               PropName has "KeyCredentials", "Certificate",
                               PropName has "Password",       "Client secret",
                               PropName has "KeyDescription", "Key/secret description",
                               PropName has "Owner",          "Ownership change",
                                                              "Other")
| project TimeGenerated, CredentialKind, OperationName, TargetName, TargetType, TargetId,
          Actor, ActorType, ActorIp, PropName, NewValue, OldValue, CorrelationId
| order by TimeGenerated desc
